    {
      "id": 9,
      "title": "RAG HTTP requests by operation / status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, status_class) (rate(atlas_rag_http_requests_total[5m]))",
          "legendFormat": "{{operation}} {{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Search hits per request",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "atlas-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(atlas_rag_search_hits_sum[5m])) / clamp_min(sum(rate(atlas_rag_search_hits_count[5m])), 0.00001)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
